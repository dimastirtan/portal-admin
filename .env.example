# ── Database portal (dittek) ───────────────────────────────────────────────────
# Pakai user MySQL khusus dashboard (hak SELECT/INSERT/UPDATE/DELETE hanya pada
# tabel modul) — BUKAN root, dan bukan user portal. Lihat README › Database.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=portal_admin
DB_PASSWORD=
DB_NAME=dittek

# ── Login admin ───────────────────────────────────────────────────────────────
# username:hash, beberapa admin dipisah koma. Username 1–10 huruf kecil/angka
# (kolom I_ENTRY tmlink hanya 10 karakter). Buat hash: npm run hash-password
# Contoh: ADMIN_USERS=dimas:scrypt.16384.8.1.xxxx.yyyy,vivi:scrypt.16384.8.1.xxxx.yyyy
ADMIN_USERS=

# ── Kontrak dengan portal ─────────────────────────────────────────────────────
# Folder unggahan portal (= UPLOAD_DIR di .env portal), mis. /home/ptdi/portal/uploads.
# Kosong = ./dev-uploads (hanya untuk uji lokal).
UPLOAD_DIR=
# Alamat internal portal untuk POST /api/cache setelah menyimpan, mis.
# http://127.0.0.1:80. Kosong = cache portal tidak dikosongkan (perubahan
# tampil setelah CACHE_TTL_SECONDS portal, default 5 menit).
PORTAL_URL=
# Token yang SAMA dengan CACHE_CLEAR_TOKEN di .env portal.
CACHE_CLEAR_TOKEN=
# Alamat portal yang dibuka admin di browser, untuk tautan "Lihat di portal",
# mis. http://portalditek.indonesian-aerospace.com. Kosong = tanpa tautan.
PORTAL_PUBLIC_URL=

# ── Server production (npm start / pm2) ───────────────────────────────────────
# ORIGIN wajib: alamat yang diketik admin di browser (tanpa ini adapter-node
# menganggap https dan form ditolak). Hapus tanda # lalu isi.
# ORIGIN=http://10.1.95.116:3100
# PORT=3100
# Batas ukuran unggahan (default adapter-node hanya 512K).
BODY_SIZE_LIMIT=20M

# File log audit (siapa mengubah apa). Kosong = ./logs/audit.log
AUDIT_LOG=
